# Line endings (UIR-56): text is LF in the working tree on every OS, so hashes of fixtures and firmware agree on Windows.
* text=auto eol=lf
# Firmware keeps its exact bytes: never converted.
*.hex -text
*.s19 -text
*.srec -text
*.mot -text
# Windows scripts need CRLF.
*.bat text eol=crlf
*.cmd text eol=crlf
*.ps1 text eol=crlf
